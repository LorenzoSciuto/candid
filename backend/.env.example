# Copy to backend/.env and fill in the required values.

# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL DSN. The default matches ./scripts/postgres.sh (local development only).
DATABASE_URL=postgresql://candid:password@localhost:5432/candid

# Encrypts API keys and SMTP passwords at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Signs session JWTs — at least 32 bytes; the app refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Google OAuth 2.0 client ID (Google Cloud Console → Credentials) — used for sign-in.
GOOGLE_CLIENT_ID=

# ── Optional ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Use explicit origins in production.
CORS_ORIGINS=http://localhost:8080,https://localhost:8080

# Public URL of the frontend, used in invitation links.
APP_URL=https://localhost:8080

# Where interview audio and candidate video answers are stored.
UPLOAD_DIR=uploads

# AI provider keys are normally configured per organisation in Settings → AI.
# Server-wide keys are ignored unless explicitly allowed, because with open
# sign-up they would pay for every organisation and every portal application.
# ALLOW_SERVER_AI_KEYS=true
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
