# Database
DATABASE_URL=postgresql://candid:password@localhost:5432/candid

# Fernet key — generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# JWT session secret — must be ≥32 bytes
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-in-production-use-a-real-secret

# Google OAuth (required for login)
GOOGLE_CLIENT_ID=

# CORS — comma-separated origins or * for all
CORS_ORIGINS=*

# Frontend URL (used in invitation emails)
APP_URL=https://localhost:8080
